      "name": "Chama AGENTE - IA e Resposta"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(it => {\n  const j = it.json;\n  const msg = String(j.mensagem || '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n  const objecoes = j.objecoes || [];\n  let found = '';\n  for (const o of objecoes) {\n    for (const g of (o.gatilhos || [])) {\n      const ng = String(g).toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n      if (ng && msg.includes(ng)) { found = o.id; break; }\n    }\n    if (found) break;\n  }\n  return { json: Object.assign({}, j, { objecao_detectada: found }) };\n});\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        140
      ],
      "id": "detecta-objecao",
      "name": "Detecta Objeção"
    }
