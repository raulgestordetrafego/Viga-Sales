    {
      "parameters": {
        "jsCode": "const it = $input.first().json;\nconst b64 = it.base64 || '';\nif (!b64) throw new Error('base64 vazio');\nconst buf = Buffer.from(b64, 'base64');\nconst mime = it.mimetype || 'application/octet-stream';\nlet ext = 'bin';\nif (mime.includes('ogg') || mime.includes('opus')) ext = 'oga';\nelse if (mime.includes('mp4') || mime.includes('m4a') || mime.includes('aac')) ext = 'mp4';\nelse if (mime.includes('mpeg') || mime.includes('mp3')) ext = 'mp3';\nelse if (mime.includes('png')) ext = 'png';\nelse if (mime.includes('jpeg') || mime.includes('jpg')) ext = 'jpg';\nelse if (mime.includes('webp')) ext = 'webp';\nelse if (mime.includes('pdf')) ext = 'pdf';\nconst bin = await this.helpers.prepareBinaryData(buf, 'media.' + ext, mime);\nreturn { json: it, binary: { data: bin } };\n"
      },
