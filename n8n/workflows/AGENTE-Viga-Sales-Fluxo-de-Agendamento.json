    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Registra a data/hora da reunião no banco de dados. Chame APÓS criar o evento no Google Calendar. Parâmetros: meeting_datetime (ISO 8601, ex: 2026-03-27T14:00:00), calendar_event_id (ID retornado pelo Google Calendar), phone (número do lead).",
        "operation": "executeQuery",
        "query": "UPDATE leads SET meeting_datetime = '{{ $fromAI(\"meeting_datetime\",\"data ISO 8601\") }}'::timestamptz, meeting_scheduled = true, meeting_calendar_event_id = '{{ $fromAI(\"calendar_event_id\",\"ID do evento\") }}', lead_stage = 'reuniao_marcada', updated_at = NOW() WHERE split_part(phone,'@',1) = split_part('{{ $fromAI(\"phone\",\"telefone do lead\") }}','@',1)",
        "options": {}
