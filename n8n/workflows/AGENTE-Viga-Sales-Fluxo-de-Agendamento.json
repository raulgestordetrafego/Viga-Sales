      "id": "e1ac3a82-7133-4c0e-b04f-340d4a29c7b3",
      "name": "Chamado pelo Agente IA",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        1136,
        608
