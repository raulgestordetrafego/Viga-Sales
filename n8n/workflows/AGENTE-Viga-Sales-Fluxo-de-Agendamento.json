      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Busca a reuniao ja agendada do lead (retorna calendar_event_id e meeting_datetime). Use ANTES de reagendar ou cancelar, para obter o Event_ID.",
        "operation": "executeQuery",
        "query": "SELECT meeting_calendar_event_id, meeting_datetime FROM leads WHERE split_part(phone,'@',1) = split_part('{{ $fromAI(\"phone\",\"telefone do lead\") }}','@',1) AND meeting_calendar_event_id IS NOT NULL ORDER BY updated_at DESC LIMIT 1",
