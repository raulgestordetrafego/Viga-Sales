    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH l AS (\n  SELECT name, business_type, company_name, city, service_interest, current_marketing,\n         has_website, has_social_media, main_pain, avg_ticket, monthly_revenue_range,\n         is_decision_maker, urgency, qualification_score, lead_stage, wants_meeting,\n         to_char(meeting_datetime,'YYYY-MM-DD HH24:MI') AS meeting_datetime, notes, CASE WHEN service_interest='trafico_pago' THEN 'trafego_pago' WHEN service_interest='criacao_de_site' THEN 'criacao_de_site' WHEN service_interest='ambos' THEN 'ambos' ELSE 'indefinida' END AS trilha\n  FROM leads\n  WHERE regexp_replace(phone,'[^0-9]','','g') = regexp_replace('{{ $('Coleta').item.json.telefone }}','[^0-9]','','g')\n  ORDER BY updated_at DESC LIMIT 1\n)\nSELECT\n  COALESCE((SELECT row_to_json(l) FROM l), '{}'::json) AS lead_card,\n  (SELECT string_agg(id || ' - ' || titulo || ': ' || COALESCE(resumo,''), chr(10) ORDER BY ordem) FROM conhecimentos WHERE ativo) AS manifest,\n  COALESCE((SELECT CASE\n     WHEN l.name IS NULL OR l.name='' THEN 'perguntar o nome'\n     WHEN l.meeting_datetime IS NOT NULL THEN 'reuniao_ja_marcada - confirme a reuniao existente (data/hora). Nao crie outra; reagende/cancele apenas se o lead pedir'\n     WHEN l.service_interest IS NULL OR l.service_interest='' THEN 'descobrir a trilha (trafego pago ou site)'\n     WHEN l.trilha='criacao_de_site' THEN (CASE\n        WHEN l.has_website IS NULL THEN 'perguntar se ja tem site/dominio (reformular ou criar do zero)'\n        WHEN l.business_type IS NULL OR l.business_type='' THEN 'perguntar o ramo do negocio'\n        WHEN l.city IS NULL OR l.city='' THEN 'perguntar a cidade/regiao'\n        WHEN l.company_name IS NULL OR l.company_name='' THEN 'perguntar o nome da empresa (ou se nao tem)'\n        WHEN l.is_decision_maker IS NULL THEN 'perguntar se decide o investimento'\n        WHEN l.monthly_revenue_range IS NULL OR l.monthly_revenue_range='' THEN 'perguntar o orcamento previsto para o site'\n        WHEN l.wants_meeting IS NOT TRUE THEN 'apresentar o pitch e convidar para a call de diagnostico'\n        ELSE 'agendar a reuniao (pedir data/hora e depois email)' END)\n     ELSE (CASE\n        WHEN l.current_marketing IS NULL OR l.current_marketing='' THEN 'perguntar se ja anuncia hoje'\n        WHEN l.has_website IS NULL THEN 'perguntar se tem site ou pagina'\n        WHEN l.business_type IS NULL OR l.business_type='' THEN 'perguntar o ramo do negocio'\n        WHEN l.city IS NULL OR l.city='' THEN 'perguntar a cidade/regiao'\n        WHEN l.company_name IS NULL OR l.company_name='' THEN 'perguntar o nome da empresa (ou se nao tem)'\n        WHEN l.is_decision_maker IS NULL THEN 'perguntar se decide o investimento'\n        WHEN l.monthly_revenue_range IS NULL OR l.monthly_revenue_range='' THEN 'perguntar o investimento mensal pretendido em anuncios'\n        WHEN l.wants_meeting IS NOT TRUE THEN 'apresentar o pitch e convidar para a call de diagnostico'\n        ELSE 'agendar a reuniao (pedir data/hora e depois email)' END)\n   END FROM l), 'novo_lead - perguntar o nome') AS proximo_passo , (SELECT json_agg(json_build_object('id', id, 'gatilhos', gatilhos) ORDER BY (CASE WHEN categoria IN ('objecao','intencao') THEN 0 ELSE 1 END), ordem) FROM conhecimentos WHERE ativo AND gatilhos IS NOT NULL) AS objecoes",
        "options": {}
      },
      "id": "busca-nome-node",
      "name": "Busca Nome Salvo",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        968,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "mMV9BeSAmDK3xqJM",
          "name": "PostgreSQL Agente"
        }
