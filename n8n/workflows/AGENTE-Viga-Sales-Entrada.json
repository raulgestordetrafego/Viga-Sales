    {
      "parameters": {
        "jsCode": "const it = $input.first().json;\nlet d = {};\ntry {\n  const c = it.choices?.[0]?.message?.content || '{}';\n  d = JSON.parse(c);\n} catch (e) { d = {}; }\nconst phone = String($('Coleta').item.json.telefone || '').replace(/\\D/g,'');\nconst esc = (v) => (v === null || v === undefined) ? '' : String(v).replace(/'/g, \"''\").trim();\nconst bool = (v) => (v === true || v === 'true') ? 'true' : (v === false || v === 'false') ? 'false' : '';\nreturn [{ json: {\n  phone,\n  name: esc(d.name),\n  business_type: esc(d.business_type), city: esc(d.city), company_name: esc(d.company_name),\n  current_marketing: esc(d.current_marketing), has_website: bool(d.has_website), has_social_media: bool(d.has_social_media),\n  main_pain: esc(d.main_pain), monthly_revenue_range: esc(d.monthly_revenue_range),\n  is_decision_maker: bool(d.is_decision_maker), service_interest: esc(d.service_interest),\n  wants_meeting: bool(d.wants_meeting), lead_stage: esc(d.lead_stage)\n}}];"
      },
      "id": "e2a610ee-3af3-433f-b8a5-e3282010d7d9",
      "name": "Parseia Perfil",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        470
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE leads SET\n    name = COALESCE(NULLIF('{{ $json.name }}',''), name),\n    business_type = COALESCE(NULLIF('{{ $json.business_type }}',''), business_type),\n    city = COALESCE(NULLIF('{{ $json.city }}',''), city),\n    company_name = COALESCE(NULLIF('{{ $json.company_name }}',''), company_name),\n    current_marketing = COALESCE(NULLIF('{{ $json.current_marketing }}',''), current_marketing),\n    has_website = COALESCE(NULLIF('{{ $json.has_website }}','')::boolean, has_website),\n    has_social_media = COALESCE(NULLIF('{{ $json.has_social_media }}','')::boolean, has_social_media),\n    main_pain = COALESCE(NULLIF('{{ $json.main_pain }}',''), main_pain),\n    monthly_revenue_range = COALESCE(NULLIF('{{ $json.monthly_revenue_range }}',''), monthly_revenue_range),\n    is_decision_maker = COALESCE(NULLIF('{{ $json.is_decision_maker }}','')::boolean, is_decision_maker),\n    service_interest = COALESCE(NULLIF('{{ $json.service_interest }}',''), service_interest),\n    wants_meeting = COALESCE(NULLIF('{{ $json.wants_meeting }}','')::boolean, wants_meeting),\n    lead_stage = COALESCE(NULLIF('{{ $json.lead_stage }}',''), lead_stage),\n    updated_at = NOW()\n  WHERE regexp_replace(phone,'[^0-9]','','g') = '{{ $json.phone }}'\n  RETURNING phone\n)\nSELECT COALESCE((SELECT phone FROM upd LIMIT 1), '{{ $json.phone }}') AS phone;",
        "options": {}
      },
