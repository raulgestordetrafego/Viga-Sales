    {
      "parameters": {
        "jsCode": "const keyId = $input.first().json.body?.data?.key?.id;\nif (!keyId) return $input.all();\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.processedIds) staticData.processedIds = {};\n\n// Limpa entradas com mais de 60 segundos\nconst now = Date.now();\nfor (const id in staticData.processedIds) {\n  if (now - staticData.processedIds[id] > 60000) {\n    delete staticData.processedIds[id];\n  }\n}\n\n// Se já processou, para tudo\nif (staticData.processedIds[keyId]) {\n  return [];\n}\n\n// Marca como processado\nstaticData.processedIds[keyId] = now;\nreturn $input.all();"
      },
