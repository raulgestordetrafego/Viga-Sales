    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH v AS (\n  SELECT\n    trim('{{ String($('Coleta').item.json.mensagem || \"\").replace(/'/g,\"''\") }}') AS msg,\n    '{{ String($('Coleta').item.json.telefone || \"\").replace(/[^0-9]/g,\"\") }}' AS phone\n),\nupd AS (\n  UPDATE leads l\n  SET name = initcap(v.msg), updated_at = NOW()\n  FROM v\n  WHERE regexp_replace(l.phone,'[^0-9]','','g') = regexp_replace(v.phone,'[^0-9]','','g')\n    AND (l.name IS NULL OR trim(l.name) = '')\n    AND v.msg ~ '^[[:alpha:]]{2,20}$'\n    AND lower(v.msg) NOT IN ('sim','nao','não','ok','oi','ola','olá','bom','boa','beleza','blz','claro','quero','queria','preciso','tenho','tudo','nada','pode','certo','vamos','acho','talvez','gostaria','obrigado','obrigada','valeu','depois','agora','hoje','amanha','amanhã','ainda','ja','já','entendo','entendi','legal','otimo','ótimo','perfeito','show','top','massa','bacana','tranquilo','espera','aguardo','ate','até','mais','menos','muito','pouco','ajuda','quanto','como','opa','fala','sou','estou','site','anuncio','anúncio','trafego','tráfego','instagram','google','empresa','valor','preco','preço','custa')\n    AND (\n      SELECT h.message->>'content'\n        FROM chat_history_viga h\n       WHERE h.session_id LIKE v.phone || '%'\n         AND h.message->>'type' = 'ai'\n       ORDER BY h.id DESC\n       LIMIT 1\n    ) ILIKE '%nome%'\n  RETURNING l.name\n)\nSELECT (SELECT name FROM upd LIMIT 1) AS nome_capturado;",
        "options": {}
      },
      "id": "1379a0d1-dfe1-41ec-bfc1-664f81c75dd7",
      "name": "Captura Nome",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        892,
        448
      ],
      "credentials": {
        "postgres": {
          "id": "mMV9BeSAmDK3xqJM",
          "name": "PostgreSQL Agente"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", temperature: 0, response_format: { type: \"json_object\" }, messages: [ { role: \"system\", content: \"Voce extrai dados de qualificacao de um lead B2B (agencia de marketing). Voce recebe o HISTORICO recente da conversa. Responda SOMENTE um JSON (sem markdown) com as chaves que der para identificar com seguranca usando o historico + a mensagem; use null nas demais. Chaves: name (apenas o PRIMEIRO NOME do lead, se ele informou/confirmou o nome; senao null), business_type (ramo do negocio), city, company_name, current_marketing (nenhum|google|meta|ambos|outro) = onde o lead PAGA ANUNCIO hoje; ter perfil/rede social NAO e anunciar ('nao anuncio nada, so tenho Instagram' => nenhum; 'faco impulsionamento/anuncio no Instagram' => meta; 'anuncio no Google Ads' => google), has_website (true|false|null), has_social_media (true se o lead TEM perfil/rede social Instagram/Facebook/TikTok, mesmo sem anunciar; false se afirmou nao ter; null se nao disse), main_pain (sem_leads|lead_ruim|sem_metrica|desperdicio|sem_site|sem_followup|outro), monthly_revenue_range, is_decision_maker (true|false|null), service_interest (trafico_pago|criacao_de_site|ambos|outro), wants_meeting (true|false|null), lead_stage (novo|qualificado|reuniao_marcada|proposta|ganho|perdido|descartado). Interprete respostas curtas pelo contexto (ex.: 'ja anuncio sim' apos falar de Instagram => current_marketing=meta). NUNCA invente o que nao foi afirmado.\" }, { role: \"user\", content: \"HISTORICO:\\n\" + ($('Busca Historico').first().json.historico || \"(vazio)\") + \"\\n\\nMENSAGEM ATUAL:\\n\" + ($('Coleta').item.json.mensagem || \"\") } ] }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth"
      },
