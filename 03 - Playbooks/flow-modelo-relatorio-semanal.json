    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst prep = $('Preparar').first().json;\nconst USD = \"\\u0024\";\nconst brl = v => 'R$ ' + Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});\nconst num = v => Number(Math.round(v||0)).toLocaleString('pt-BR');\nconst pctv = v => Number(v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2})+'%';\nfunction gsum(node){\n  const d = node.first().json; const rs = (d && d.results) ? d.results : [];\n  let imp=0,clk=0,cost=0,conv=0;\n  for(const r of rs){ const m=r.metrics||{}; imp+=Number(m.impressions||0); clk+=Number(m.clicks||0); cost+=Number(m.costMicros||0)/1e6; conv+=Number(m.conversions||0); }\n  return {imp,clk,cost,conv,ctr: imp?clk/imp*100:0, cpa: conv?cost/conv:0, cpc: clk?cost/clk:0};\n}\nfunction msum(node){\n  const d = node.first().json; const rows = (d && d.data) ? d.data : [];\n  let imp=0,reach=0,cost=0,conv=0,wcost=0,traf=0;\n  for(const r of rows){\n    const sp=Number(r.spend||0); imp+=Number(r.impressions||0); reach+=Number(r.reach||0); cost+=sp;\n    const cn=(r.campaign_name||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'');\n    if(cn.includes('trafego')) traf+=sp;\n    const isWpp = cn.includes('vendas whatsapp');\n    const acts={}; for(const a of (r.actions||[])) acts[a.action_type]=Number(a.value||0);\n    const c = acts['onsite_conversion.messaging_conversation_started_7d']||0;\n    if(isWpp){ conv+=c; wcost+=sp; }\n  }\n  return {imp,reach,cost,conv,wcost,traf,cpa: conv?wcost/conv:0};\n}\nconst gw=gsum($('Google Ads Semana')), gm=gsum($('Google Ads Mes'));\nconst mw=msum($('Meta Ads Semana')), mm=msum($('Meta Ads Mes'));\nconst igBase = Number(($('IG Seguidores').first().json||{}).followers_count||0);\nconst igd = $('IG Novos').first().json;\nlet novos=0; for(const s of ((igd&&igd.data)||[])) for(const v of (s.values||[])) novos+=Number(v.value||0);\nconst L=[];\nL.push('📊 *Casa da Fé — Acompanhamento Semanal*');\nL.push('🗓 _Semana '+prep.week_label+' · Viga Sales_');\nL.push('');\nL.push('🔎 *Google Ads*');\nL.push('💰 Investido: '+brl(gw.cost)+' | 🎯 Conversões: '+num(gw.conv)+' (CPA '+brl(gw.cpa)+')');\nL.push('🖱️ Cliques: '+num(gw.clk)+' (CTR '+pctv(gw.ctr)+')');\nL.push('');\nL.push('📣 *Meta Ads*');\nL.push('💰 Investido: '+brl(mw.cost)+' | 👁️ Alcance: '+num(mw.reach));\nL.push('📈 Impressões: '+num(mw.imp));\nL.push('💬 Conversas WhatsApp: '+num(mw.conv)+' (CPA '+brl(mw.cpa)+')');\nL.push('');\nL.push('📸 *Instagram*');\nL.push('👥 Seguidores: '+num(igBase)+' ('+(novos>=0?'+':'')+num(novos)+' na semana)');\nconst cpsem=(mw.traf&&novos>0)?mw.traf/novos:null;\nL.push('💵 Custo por novo seguidor: '+(cpsem!=null?brl(cpsem):'—'));\nL.push('🎯 Faltam '+num(Math.max(0, Number(cfg.base_seg_alvo)-igBase))+' para '+num(cfg.base_seg_alvo));\nL.push('');\nconst pl = mm.conv && Number(cfg.meta_leads_alvo) ? (mm.conv/Number(cfg.meta_leads_alvo)*100) : null;\nconst pa = mm.reach && Number(cfg.meta_alcance_alvo) ? (mm.reach/Number(cfg.meta_alcance_alvo)*100) : null;\nL.push('🏆 *Metas de '+prep.month_label+'*');\nL.push('💬 Leads WhatsApp: '+num(mm.conv)+'/'+num(cfg.meta_leads_alvo)+(pl!=null?' ('+pctv(pl)+')':''));\nL.push('📢 Alcance: '+num(mm.reach)+'/'+num(cfg.meta_alcance_alvo)+(pa!=null?' ('+pctv(pa)+')':''));\nL.push('👥 Base de seguidores: '+num(igBase)+'/'+num(cfg.base_seg_alvo));\nL.push('');\nL.push('🔗 Dashboard completo: '+cfg.dashboard_url);\nreturn [{ json: { number: cfg.whatsapp_group, message: L.join('\\n') } }];\n"
      },
