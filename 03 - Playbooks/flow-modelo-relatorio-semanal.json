    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst now = DateTime.now().setZone('America/Sao_Paulo');\nconst today = now.startOf('day');\nconst monday = today.minus({ days: today.weekday - 1 });\nconst weekStart = monday.minus({ weeks: 1 });\nconst weekEnd = monday.minus({ days: 1 });\nconst monthStart = now.startOf('month');\nconst f = d => d.toFormat('yyyy-MM-dd');\nconst ws=f(weekStart), we=f(weekEnd), ms=f(monthStart), me=f(today);\nconst gQ = (a,b) => \"SELECT metrics.impressions, metrics.clicks, metrics.cost_micros, metrics.conversions FROM customer WHERE segments.date BETWEEN '\"+a+\"' AND '\"+b+\"'\";\nconst metaUrl = (a,b) => \"https://graph.facebook.com/v26.0/act_\"+cfg.meta_account+\"/insights?fields=campaign_name,spend,impressions,reach,actions&time_range=\"+encodeURIComponent(JSON.stringify({since:a,until:b}))+\"&level=campaign&limit=500&access_token=\"+cfg.meta_token;\nreturn [{ json: {\n  week_label: weekStart.toFormat('dd/MM')+' a '+weekEnd.toFormat('dd/MM'),\n  month_label: ['Janeiro','Fevereiro','Marco','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'][now.month-1]+' '+now.year,\n  google_week_body: JSON.stringify({ query: gQ(ws,we) }),\n  google_month_body: JSON.stringify({ query: gQ(ms,me) }),\n  meta_week_url: metaUrl(ws, we),\n  meta_month_url: metaUrl(ms, me),\n  ig_base_url: \"https://graph.facebook.com/v26.0/\"+cfg.ig_id+\"?fields=followers_count&access_token=\"+cfg.meta_token,\n  ig_insights_url: \"https://graph.facebook.com/v26.0/\"+cfg.ig_id+\"/insights?metric=follower_count&period=day&since=\"+ws+\"&until=\"+weekEnd.plus({days:1}).toFormat('yyyy-MM-dd')+\"&access_token=\"+cfg.meta_token\n}}];\n"
      },
