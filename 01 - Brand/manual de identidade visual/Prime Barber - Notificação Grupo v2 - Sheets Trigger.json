    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rows = items\n  .filter(i => typeof i.json.created_time === 'string' && i.json.created_time.trim() !== '')\n  .filter(i => {\n    const status = String(i.json.grupo_notificado || '').trim().toLowerCase();\n    return status !== 'notificado';\n  })\n  .map(i => i.json);\nreturn [{ json: { exists: rows.length > 0, rowsInLastMinute: rows } }];"
      },
