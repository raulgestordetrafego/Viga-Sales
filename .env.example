# Evolution API Configuration
EVOLUTION_API_URL=https://sua-evolution-api.seudominio.com
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_INSTANCE=NomeDaInstancia
# Instância da Evolution API usada pela AB Capital para prospecção ativa (mensagens ao prospect)
AB_CAPITAL_EVOLUTION_INSTANCE=
# Instância usada para notificações internas ao grupo (resumo de tarefas, follow-ups) — padrão: Adila_pessoal
AB_CAPITAL_NOTIFY_INSTANCE=Adila_pessoal

# Webhook Configuration
# WEBHOOK_URL: URL pública desta aplicação para receber eventos da Evolution API.
# Exemplo: https://viga-sales.seudominio.com/webhook/evolution
WEBHOOK_URL=

# WEBHOOK_SECRET: Segredo compartilhado com a Evolution API para validar a origem dos webhooks.
# Gere com: openssl rand -hex 32
# Configure o mesmo valor no painel da Evolution API como "webhook secret/apikey".
WEBHOOK_SECRET=

# FORWARD_WEBHOOK_URL: (Opcional) Se quiser encaminhar os eventos para o n8n ou outro serviço.
# Deixe vazio para desativar.
FORWARD_WEBHOOK_URL=

# Server Configuration
PORT=3000
NODE_ENV=development

# App URL (usado para gerar URLs de webhook)
APP_URL=https://viga-sales.seudominio.com

# Auth / Security
# JWT_SECRET: Chave secreta para assinar tokens JWT. OBRIGATÓRIA em produção.
# Gere com: openssl rand -hex 32
JWT_SECRET=
# Master admin credentials (criado automaticamente no primeiro start se não existir)
CRM_MASTER_EMAIL=seuemail@dominio.com
CRM_MASTER_PASSWORD=SenhaForteAqui!
# Chave OpenAI (usado para geração de mensagens de prospecção com IA)
OPENAI_API_KEY=
# Chave Gemini (usado para geração de mensagens de prospecção com IA)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# ElevenLabs — voz clonada para notas de voz do SDR (TTS)
# API key começa com "sk_" (não é o key ID). voice_id sai de GET /v1/voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Nome do remetente usado nas mensagens geradas pela IA (padrão: Raul)
SENDER_NAME=Raul

# Internal API Authentication — tokens para comunicação entre serviços
# VIGA_INTERNAL_TOKEN: usado para autenticar chamadas internas (n8n, agentes, etc.)
# Gere com: openssl rand -hex 16
VIGA_INTERNAL_TOKEN=
# N8N_AUTH_TOKEN: token para autenticar chamadas do n8n para a API
# Gere com: openssl rand -hex 16
N8N_AUTH_TOKEN=

# Prospecção Automática - Apify (Google Maps / Instagram Scraper)
# Crie uma conta em https://apify.com e gere um token em Settings > API & Integrations
APIFY_TOKEN=

# Database Configuration
# Default: SQLite em ./db/crm.sqlite (criado automaticamente, sem setup)
DB_PATH=./db/crm.sqlite
# Para PostgreSQL (ex: Supabase, Neon), forneça a connection string:
DATABASE_URL=

# Email SMTP/IMAP (servidor Poste.io)
SMTP_HOST=mail.vigasales.com.br
SMTP_PORT=587
SMTP_USER=contato@vigasales.com.br
SMTP_PASSWORD=sua_senha_smtp
IMAP_HOST=mail.vigasales.com.br
IMAP_PORT=993
IMAP_USER=contato@vigasales.com.br
IMAP_PASSWORD=sua_senha_imap

# ── Senhas dos Postgres (docker-compose)
POSTGRES_AGENTE_PASSWORD=
POSTGRES_CRM_PASSWORD=
POSTGRES_LEADS_PASSWORD=

# ── Meta Ads (Marketing API) — System User com ads_read/ads_management
META_ADS_ACCESS_TOKEN=
# Conta padrão do sync global (ex.: act_647608993803728)
META_ADS_AD_ACCOUNT_ID=
META_ADS_PIXEL_ID=

# ── Google Ads API (descoberta via MCC)
# Reusa o OAuth client do GTM/Search Console (projeto "Cliente Web 1_automacoes google ads")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Gerado por: node scripts/google-ads-oauth.mjs  (escopo .../auth/adwords)
GOOGLE_ADS_REFRESH_TOKEN=
# API Center do Google Ads (MCC) → Ferramentas → Configurações → Acesso à API
GOOGLE_ADS_DEVELOPER_TOKEN=
# ID da conta MCC (só dígitos)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Versão da Google Ads API (default v22)
GOOGLE_ADS_API_VERSION=v22
# Search Console / GTM (reuso do OAuth acima)
SEARCH_CONSOLE_REFRESH_TOKEN=
GTM_REFRESH_TOKEN=
